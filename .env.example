# ============================================================
#  SD Sistema — variables de entorno (plantilla)
#  Copia este archivo a .env.local y rellena con tus valores.
#  NUNCA commitees .env.local (está en .gitignore).
#
#  En Vite SOLO las variables con prefijo VITE_ llegan al cliente.
#  => Nada secreto aquí: estas claves viajan al navegador.
#     La seguridad real vive en las políticas RLS de Supabase.
# ============================================================

# URL del proyecto Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# Clave pública / anon (publishable). Protegida por RLS, segura en el cliente.
VITE_SUPABASE_ANON_KEY="eyJhbGciOi...tu-anon-key..."

# Nombre visible de la app (opcional)
VITE_APP_NAME="Systems Development"

# Entorno lógico: development | staging | production (opcional)
VITE_APP_ENV="development"

# ------------------------------------------------------------
# NO poner aquí la service_role key. Esa clave omite RLS y jamás
# debe exponerse en el cliente. Si más adelante agregas funciones
# de servidor, guárdala solo en el entorno del servidor/Vercel.
# ------------------------------------------------------------
