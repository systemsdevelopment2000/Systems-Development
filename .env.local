# Entorno LOCAL de desarrollo — valores PLACEHOLDER.
# Reemplaza por las credenciales reales de tu proyecto Supabase cuando lo creemos.
# (Este archivo está en .gitignore; no se versiona.)

VITE_SUPABASE_URL="https://placeholder.supabase.co"
VITE_SUPABASE_ANON_KEY="placeholder-anon-key-reemplazar"
VITE_APP_NAME="Systems Development"
VITE_APP_ENV="development"

# Bypass de autenticación SOLO para desarrollo local (ver la app sin Supabase real).
# Se ignora automáticamente si VITE_APP_ENV="production". Poner "false" para exigir login.
VITE_AUTH_BYPASS="true"
